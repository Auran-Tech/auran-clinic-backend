{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=StageAClinic;Trusted_Connection=True;MultipleActiveResultSets=true;Encrypt=false"
  },
  "Jwt": {
    "Issuer": "Auran.Clinic",
    "Audience": "Auran.Clinic.Client",
    "SigningKey": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "PlatformBootstrap": {
    "Enabled": false,
    "FullName": "",
    "Email": "",
    "Password": "",
    "Phone": ""
  },
  "FileStorage": {
    "Provider": "Local",
    "LocalRootPath": "storage",
    "UploadSessionMinutes": 15,
    "MaxFileSizeMb": 50
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "WriteTo": [ { "Name": "Console" } ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
