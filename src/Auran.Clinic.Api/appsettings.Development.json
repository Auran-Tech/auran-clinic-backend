{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=AuranClinic;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "SigningKey": "AuranClinic-Development-Only-Signing-Key-Change-Me-2026"
  },
  "PlatformBootstrap": {
    "Enabled": false
  },
  "Cache": {
    "Provider": "Memory",
    "Redis": {
      "ConnectionString": "localhost:6379",
      "InstanceName": "AuranClinic:Dev:"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "WriteTo": [ { "Name": "Console" } ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": { "Microsoft": "Information" }
    }
  }
}
