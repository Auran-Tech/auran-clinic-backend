{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Auran Clinic API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build Auran Clinic API",
      "program": "${workspaceFolder}/src/Auran.Clinic.Api/bin/Debug/net10.0/Auran.Clinic.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Auran.Clinic.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7180;http://localhost:5180"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    }
  ]
}
